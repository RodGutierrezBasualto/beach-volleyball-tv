# Copy this file to ".env" to run locally with GitHub storage. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# GitHub storage: the admin commits content to this repo's content/ folder.
# Token: github.com → Settings → Developer settings → Fine-grained tokens →
#   Repository access: only this repo · Permissions: Contents → Read and write
GITHUB_REPO=your-name/beach-volleyball-tv
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Admin login (required once GITHUB_TOKEN is set)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Any long random string; keeps people logged in across restarts
SESSION_SECRET=
