---
import Photo from './Photo.astro';

interface Props { eyebrow: string; title: string; lede?: string; image?: string; imageAlt?: string }
const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<header class="page-head">
  <div class="container">
    <div class:list={['page-head__grid', image && 'page-head__grid--media']}>
      <div data-reveal>
        <span class="eyebrow">{eyebrow}</span>
        <h1 class="display-xl" set:html={title} />
        {lede && <p class="lede">{lede}</p>}
        <div class="page-head__actions"><slot name="actions" /></div>
      </div>
      {image && (
        <div class="page-head__media" data-reveal style="--d:.1s">
          <Photo name={image} alt={imageAlt} sizes="(min-width: 900px) 45vw, 100vw" eager />
        </div>
      )}
    </div>
  </div>
</header>
