---
// Instagram figures, edited in the admin (About page → Instagram statistics).
import { getPage } from '../lib/content';

const { stats, period } = getPage('about').growth;
---

<div class="stats-row" data-reveal>
  {stats.map((s) => (
    <div class="stat-tile">
      <b>{s.value}</b>
      <span>{s.label}</span>
      {s.change && <small>{s.change}</small>}
    </div>
  ))}
</div>
{period && <p class="stats-note">Instagram statistics, {period}.</p>}
