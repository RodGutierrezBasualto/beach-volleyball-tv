---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import Icon from '../components/Icon.astro';
import { videoCategories, channel } from '../data/videos';
import { getVideos, featuredVideo as getFeaturedVideo } from '../lib/content';

const videos = getVideos();
const featuredVideo = getFeaturedVideo();

const library = videos.filter((v) => v.youtubeId !== featuredVideo.youtubeId);
const counts = Object.fromEntries(videoCategories.map((c) => [c, library.filter((v) => v.category === c).length]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Beach Volleyball TV video library',
  itemListElement: videos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://www.youtube.com/watch?v=${v.youtubeId}`,
    name: v.title,
  })),
};
---

<BaseLayout
  title="YouTube — Interviews, Tournaments & Highlights"
  description="Watch Beach Volleyball TV: interviews with Olympians and local legends, tournament finals, mic’d up highlights and our weekly beach volleyball news show."
  jsonLd={jsonLd}
>
  <header class="page-head band-dark" style="padding-bottom: clamp(48px, 6vw, 80px)">
    <div class="container">
      <div class="page-head__grid page-head__grid--media" style="align-items:center">
        <div data-reveal>
          <span class="eyebrow">Beach Volleyball TV on YouTube</span>
          <h1 class="display-xl">Watch the game <em>up close</em></h1>
          <p class="lede" style="color: rgb(255 255 255 / .75)">Olympians, rising stars, local legends and finals from the sand — filmed in Bondi and beyond.</p>
          <div class="page-head__actions">
            <a class="btn btn--light" href={channel.subscribeUrl} target="_blank" rel="noopener"><Icon name="youtube" /> Subscribe to the channel<span class="sr-only"> (opens in a new tab)</span></a>
            <a class="btn btn--ghost-light" href="#library">Browse videos</a>
          </div>
        </div>
        <div data-reveal style="--d:.1s">
          <LiteYouTube youtubeId={featuredVideo.youtubeId} title={featuredVideo.title} image={featuredVideo.image} label="Featured" eager />
          <h2 style="margin-top:18px; font-size: clamp(1.2rem, 2vw, 1.5rem)">{featuredVideo.title}</h2>
          <p style="margin-top:6px; color: rgb(255 255 255 / .65)">{featuredVideo.description}</p>
        </div>
      </div>
    </div>
  </header>

  <section class="section" id="library" aria-labelledby="library-title" style="padding-top: clamp(48px, 6vw, 80px)">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">Video library</span>
          <h2 id="library-title" class="display-l">Every story, <em>on demand</em></h2>
        </div>
        <div class="chips" id="video-filters" data-filter-group data-filter-target="#video-grid" role="group" aria-label="Filter videos by category">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="count">{library.length}</span></button>
          {videoCategories.map((c) => (
            <button class="chip" type="button" data-filter={c} aria-pressed="false">{c} <span class="count">{counts[c]}</span></button>
          ))}
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status="video-filters"></p>
      <div class="grid-cards" id="video-grid" style="row-gap: clamp(32px, 4vw, 48px)">
        {library.map((v, i) => <VideoCard video={v} delay={(i % 3) * 0.06} />)}
      </div>
      <div class="empty" data-filter-empty="video-filters" hidden>
        <strong>New episodes on the way</strong>
        Subscribe on YouTube to be the first to watch.
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="subscribe-title">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow" style="color: var(--ink)">Never miss a rally</span>
          <h2 id="subscribe-title" style="margin-top:14px">Subscribe to <em>Beach Volleyball TV</em></h2>
          <p>New interviews, finals and weekly news from Australian beach volleyball. Want your event or story on the channel? Let’s talk.</p>
        </div>
        <div class="cta-band__actions">
          <a class="btn" href={channel.subscribeUrl} target="_blank" rel="noopener"><Icon name="youtube" /> Subscribe<span class="sr-only"> (opens in a new tab)</span></a>
          <a class="btn btn--light" href="/contact/?type=media">Pitch a video</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
