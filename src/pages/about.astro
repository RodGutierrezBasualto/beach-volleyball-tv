---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import InstagramStats from '../components/InstagramStats.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getPage } from '../lib/content';
import { headlineHtml, formatInline } from '../lib/utils';

const { header, story, growth, values, team } = getPage('about');
const initials = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---

<BaseLayout
  title="About Us — Born in Bondi"
  description="Beach Volleyball TV was born in Bondi from social games and tournaments. Our vision, mission, values and team — led by Sydney 2000 Olympian Christie Mokotupu."
>
  <PageHeader eyebrow={header.eyebrow} title={headlineHtml(header)} lede={header.lede} image={header.photo} imageAlt={header.photoAlt} />

  <section class="section">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow">{story.eyebrow}</span>
        <h2 class="display-l" style="margin-top:14px" set:html={headlineHtml(story)} />
        {story.paragraphs.map((p, i) => <p class="lede" style={`margin-top:${i ? 14 : 20}px`}>{p}</p>)}
        <a class="link-arrow" href={site.instagram.url} target="_blank" rel="noopener" style="margin-top:20px">{story.linkLabel} <Icon name="external" /></a>
      </div>
      <div class="info-cards">
        <article class="info-card" data-reveal style="--d:.06s">
          <span class="info-card__icon"><Icon name="star" /></span>
          <h3>{story.visionTitle}</h3>
          {story.visionText && <p>{story.visionText}</p>}
        </article>
        <article class="info-card info-card--accent" data-reveal style="--d:.12s">
          <span class="info-card__icon"><Icon name="heart" /></span>
          <h3>{story.missionTitle}</h3>
          {story.missionText && <p>{story.missionText}</p>}
        </article>
      </div>
    </div>
  </section>

  {growth.show && (
  <section class="section section--soft" aria-labelledby="growth-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">{growth.eyebrow}</span>
          <h2 id="growth-title" class="display-l" set:html={headlineHtml(growth)} />
          {growth.text && <p>{growth.text}</p>}
        </div>
      </div>
      <InstagramStats />
    </div>
  </section>
  )}

  {values.show && (
  <section class="section" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">{values.eyebrow}</span>
          <h2 id="values-title" class="display-l" set:html={headlineHtml(values)} />
        </div>
      </div>
      <ol class="values" role="list">
        {values.items.map((v, i) => (
          <li class="value" data-reveal style={`--d:${(i % 3) * 0.06}s`}>
            <span class="value__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.title}</h3>
            {v.text && <p>{v.text}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>
  )}

  {team.show && (
  <section class="section section--soft" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">{team.eyebrow}</span>
          <h2 id="team-title" class="display-l" set:html={headlineHtml(team)} />
        </div>
      </div>
      <article class="profile" data-reveal>
        <figure class="profile__photo">
          <Photo name={team.photo} alt={team.photoAlt} sizes="(min-width: 900px) 420px, 100vw" />
          {team.photoCredit && <figcaption>{team.photoCredit}</figcaption>}
        </figure>
        <div class="profile__body">
          <h3>{team.name}</h3>
          {team.role && <p class="profile__role">{team.role}</p>}
          <div class="profile__text">
            {team.paragraphs.map((p) => <p set:html={formatInline(p)} />)}
            {team.quote && <p class="profile__quote">{team.quote}</p>}
          </div>
        </div>
      </article>
      {team.members.length > 0 && (
        <div class="team-grid">
          {team.members.map((m, i) => (
            <article class="team-member" data-reveal style={`--d:${(i % 3) * 0.06}s`}>
              {m.photo
                ? <Photo name={m.photo} alt={m.photoAlt} sizes="(min-width: 900px) 300px, (min-width: 560px) 45vw, 100vw" />
                : <div class="team-member__initials" aria-hidden="true">{initials(m.name)}</div>}
              <h3>{m.name}</h3>
              {m.role && <p class="team-member__role">{m.role}</p>}
              {m.bio && <p class="team-member__bio" set:html={formatInline(m.bio)} />}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
  )}
</BaseLayout>
