---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import EventCard from '../components/EventCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import VideoCard from '../components/VideoCard.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import { site } from '../data/site';
import { channel } from '../data/videos';
import { getArticles, getVideos, featuredVideo as getFeaturedVideo } from '../lib/content';
import { upcomingEvents } from '../lib/utils';

const nextEvents = upcomingEvents().slice(0, 3);
const [lead, ...rest] = getArticles();
const videos = getVideos();
const featuredVideo = getFeaturedVideo();
const sideStories = rest.slice(0, 3);
const sideVideos = videos.filter((v) => v.youtubeId !== featuredVideo.youtubeId).slice(0, 2);

const tiles = [
  { n: '01', title: 'Events', text: 'Tournaments, clinics and sunrise socials across Bondi and the Eastern Suburbs.', href: '/events/', image: 'bv-sunset-silhouettes', alt: 'Players leaping at the net at sunset' },
  { n: '02', title: 'News', text: 'Tournament highlights, athlete profiles and stories from the community.', href: '/news/', image: 'yt-U8XTZGnaD1o', alt: 'An athlete relaxing on the grass above Bondi Beach' },
  { n: '03', title: 'YouTube', text: 'Interviews with Olympians, finals, mic’d up games and our weekly news show.', href: '/youtube/', image: 'yt-Yn0AGAttFps', alt: 'Players mic’d up on the sand at Bondi Beach' },
];
---

<BaseLayout description="Beach Volleyball TV is an Australian beach volleyball community born in Bondi. Find tournaments, clinics and social sessions, read stories from the sand and watch interviews and highlights.">
  <!-- Hero -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <canvas class="hero__canvas" data-hero-ball aria-hidden="true"></canvas>
    <div class="container hero__inner">
      <div class="hero__content" data-hero-content>
        <p class="hero__kicker" data-hero-in="1">Born in Bondi · Sydney, Australia</p>
        <h1 id="hero-title" data-hero-in="2"><span>Beach</span> <span>Volleyball <em>TV</em></span></h1>
        <p class="hero__tagline" data-hero-in="3">{site.tagline}</p>
        <div class="hero__actions" data-hero-in="4">
          <a class="btn" href="#community">Explore the Community <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--light" href={site.youtube.url} target="_blank" rel="noopener">
            <Icon name="youtube" /> Watch on YouTube<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
    <div class="container hero__bar" data-hero-ground data-hero-in="5">
      <span>Est. on the sand at Bondi</span>
      <span class="hero__hint" aria-hidden="true">Give the ball a nudge</span>
      <span>33.89° S · 151.27° E</span>
    </div>
  </section>

  <!-- Intro -->
  <section class="section" id="community" aria-labelledby="intro-title">
    <div class="container intro">
      <div data-reveal>
        <span class="eyebrow">Born in Bondi</span>
        <h2 id="intro-title" class="display-l" style="margin-top:14px">From 6am socials to Olympic stories — <em>this is our beach.</em></h2>
        <p class="lede" style="margin-top:22px">
          Beach Volleyball TV started on the sand at Bondi with a camera, a net and a crew who couldn’t stop talking about the game.
          Today we’re a home for everyone who loves beach volleyball in Australia — the players, the coaches, the legends and the people who just turn up to watch.
        </p>
        <div class="pillars">
          <div class="pillar"><span class="pillar__n">01</span><h3>Community</h3><p>Social sessions, clinics and events that welcome every level onto the sand.</p></div>
          <div class="pillar"><span class="pillar__n">02</span><h3>Sport</h3><p>Tournaments across Bondi and the Eastern Suburbs, filmed for the channel.</p></div>
          <div class="pillar"><span class="pillar__n">03</span><h3>Stories</h3><p>Interviews with Olympians, rising athletes and the beach icons behind the game.</p></div>
        </div>
      </div>
      <div class="intro__collage" data-reveal style="--d:.12s">
        <Photo name="yt-u9tlUaKomis" alt="A player passing the ball on Bondi Beach with the apartments of Bondi behind" class="a" sizes="(min-width: 960px) 40vw, 90vw" />
        <Photo name="volleyball-ball" alt="Close-up of a yellow and blue volleyball" class="b" sizes="(min-width: 960px) 22vw, 50vw" />
        <div class="intro__stamp" aria-hidden="true">
          <svg viewBox="0 0 100 100"><defs><path id="stamp-path" d="M50 50 m-38 0 a38 38 0 1 1 76 0 a38 38 0 1 1 -76 0" /></defs><text font-size="8.6" font-weight="600" letter-spacing="2.4" fill="currentColor" font-family="Instrument Sans, sans-serif"><textPath href="#stamp-path">COMMUNITY · SPORT · STORIES · </textPath></text></svg>
          <b>BVTV</b>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore tiles -->
  <section class="section section--soft" aria-labelledby="explore-title">
    <div class="container">
      <SectionHead id="explore-title" eyebrow="Explore" title="Find your way <em>onto the sand</em>" />
      <div class="tiles">
        {tiles.map((tile, i) => (
          <article class="tile" data-reveal style={`--d:${i * 0.08}s`}>
            <Photo name={tile.image} alt={tile.alt} sizes="(min-width: 800px) 33vw, 100vw" />
            <span class="tile__n" aria-hidden="true">{tile.n}</span>
            <span class="tile__arrow" aria-hidden="true"><Icon name="arrow" /></span>
            <h3><a class="stretched" href={tile.href}>{tile.title}</a></h3>
            <p>{tile.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Upcoming events -->
  <section class="section" aria-labelledby="events-title">
    <div class="container">
      <SectionHead id="events-title" eyebrow="What’s on" title="Upcoming <em>on the sand</em>" text="Tournaments, clinics and community sessions around Bondi and the Eastern Suburbs.">
        <a class="link-arrow" href="/events/">All events <Icon name="arrow" /></a>
      </SectionHead>
      {nextEvents.length ? (
        <div class="grid-cards">
          {nextEvents.map((e, i) => <EventCard event={e} delay={i * 0.08} />)}
        </div>
      ) : (
        <div class="empty"><strong>New dates coming soon</strong>Follow us on Instagram to hear first.</div>
      )}
    </div>
  </section>

  <!-- Latest stories -->
  <section class="section section--soft" aria-labelledby="news-title">
    <div class="container">
      <SectionHead id="news-title" eyebrow="Latest stories" title="News from <em>the beach</em>">
        <a class="link-arrow" href="/news/">All stories <Icon name="arrow" /></a>
      </SectionHead>
      <div class="magazine">
        <ArticleCard article={lead} variant="lead" />
        <div class="magazine__side">
          {sideStories.map((a, i) => <ArticleCard article={a} variant="compact" delay={0.08 * (i + 1)} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section band-dark" aria-labelledby="video-title">
    <div class="container">
      <SectionHead id="video-title" eyebrow="Watch" title="Fresh from <em>the channel</em>" text="Interviews with Olympians and local legends, tournament finals and our weekly beach volleyball news.">
        <a class="btn btn--light" href={channel.subscribeUrl} target="_blank" rel="noopener"><Icon name="youtube" /> Subscribe<span class="sr-only"> on YouTube (opens in a new tab)</span></a>
      </SectionHead>
      <div class="video-split">
        <div data-reveal>
          <LiteYouTube youtubeId={featuredVideo.youtubeId} title={featuredVideo.title} image={featuredVideo.image} label="Featured" />
        </div>
        <div class="video-split__side">
          {sideVideos.map((v, i) => <VideoCard video={v} delay={0.08 * (i + 1)} />)}
          <a class="link-arrow" href="/youtube/" style="color: var(--teal-300)">Browse the full video library <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Join -->
  <section class="section" aria-labelledby="join-title">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow" style="color: var(--ink)">Join us</span>
          <h2 id="join-title" style="margin-top:14px">Come play. Come watch. <em>Come say g’day.</em></h2>
          <p>Whether you want to play, partner with us or tell your story on the channel — we’d love to hear from you.</p>
        </div>
        <div class="cta-band__actions">
          <a class="btn" href="/contact/">Get in touch <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--light" href={site.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> {site.instagram.handle}</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
