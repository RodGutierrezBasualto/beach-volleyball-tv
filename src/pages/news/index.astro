---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { newsCategories } from '../../data/news';
import { getArticles, getVideos, featuredArticle as getFeaturedArticle } from '../../lib/content';
import VideoCard from '../../components/VideoCard.astro';
import ContactButton from '../../components/ContactButton.astro';
import { site } from '../../data/site';

const sortedArticles = getArticles();
const featuredArticle = getFeaturedArticle();

const others = sortedArticles.filter((a) => a !== featuredArticle);
const latestVideos = getVideos().slice(0, 3);
const counts = Object.fromEntries(newsCategories.map((c) => [c, others.filter((a) => a.category === c).length]));
---

<BaseLayout
  title="News & Media — Latest News, Videos, Podcasts & Interviews"
  description="Tournament highlights, interviews, athlete profiles and community stories from Beach Volleyball TV — Australian beach volleyball, born in Bondi."
>
  <header class="page-head">
    <div class="container">
      <div data-reveal style="max-width: 980px">
        <span class="eyebrow">News</span>
        <h1 class="display-xl">Latest news, videos, <em>podcasts & interviews</em></h1>
        <p class="lede">Stay up to date with the latest beach volleyball news, tournament highlights, exclusive interviews, podcasts and behind-the-scenes action from Australia and around the world.</p>
        <p class="lede" style="margin-top:12px">Discover inspiring stories, celebrate athletes and connect with the people and communities that make our sport special.</p>
        <div class="page-head__actions">
          <a class="btn" href={site.youtube.url} target="_blank" rel="noopener"><Icon name="youtube" /> YouTube<span class="sr-only"> (opens in a new tab)</span></a>
          <a class="btn btn--ghost" href={site.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
    </div>
  </header>

  <section class="section section--tight" aria-label="Featured story">
    <div class="container">
      <ArticleCard article={featuredArticle} variant="lead" headingLevel="h2" eager />
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="all-stories">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">Archive</span>
          <h2 id="all-stories" class="display-l">Latest stories</h2>
        </div>
        <div class="chips" id="news-filters" data-filter-group data-filter-target="#news-grid" role="group" aria-label="Filter stories by category">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="count">{others.length}</span></button>
          {newsCategories.filter((c) => counts[c] > 0).map((c) => (
            <button class="chip" type="button" data-filter={c} aria-pressed="false">{c} <span class="count">{counts[c]}</span></button>
          ))}
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status="news-filters"></p>
      <div class="grid-cards" id="news-grid" style="row-gap: clamp(36px, 4vw, 56px)">
        {others.map((a, i) => <ArticleCard article={a} delay={(i % 3) * 0.06} />)}
      </div>
      <div class="empty" data-filter-empty="news-filters" hidden><strong>No stories here yet</strong>Check back soon.</div>
    </div>
  </section>

  <section class="section band-dark" aria-labelledby="videos-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">Videos & podcasts</span>
          <h2 id="videos-title" class="display-l">Watch the latest</h2>
          <p>Interviews, weekly broadcasts, podcasts and highlights from the Beach Volleyball TV channel.</p>
        </div>
        <a class="btn btn--light" href="/youtube/">All videos <Icon name="arrow" class="arrow" /></a>
      </div>
      <div class="grid-cards">{latestVideos.map((v, i) => <VideoCard video={v} delay={i * 0.06} />)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="pitch-title">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow" style="color: var(--ink)">Got a story?</span>
          <h2 id="pitch-title" style="margin-top:14px">Every beach has <em>its legends.</em></h2>
          <p>Know a player, coach or club whose story deserves telling? Send us a tip.</p>
        </div>
        <div class="cta-band__actions">
          <ContactButton label="Share a story" href="/contact/?type=media&subject=Story%20tip" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
