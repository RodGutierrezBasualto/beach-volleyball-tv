---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, enquiryTypes, recipientFor } from '../data/site';
const enabled = site.contactEnabled;
---

<BaseLayout
  title="Contact — Media Enquiries, Bookings & General Enquiries"
  description="Contact Beach Volleyball TV for media interviews, event coverage, podcast appearances, athlete features, speaking engagements, sponsorships and partnerships."
>
  <header class="page-head">
    <div class="container">
      <div data-reveal style="max-width: 980px">
        <span class="eyebrow">Contact</span>
        <h1 class="display-xl">Media enquiries, bookings <em>& general enquiries</em></h1>
        <p class="lede"><b>We’d love to hear from you!</b> Whether you’re a media organisation, athlete, sporting club, business or member of the community, Beach Volleyball TV welcomes enquiries and opportunities to connect.</p>
      </div>
    </div>
  </header>

  <section class="section section--tight">
    <div class="container contact-grid">
      <div data-reveal>
        <div class="enquiry-list" style="margin-top:0">
          <div>
            <h3>Media & bookings</h3>
            <p>Contact us for media interviews, press enquiries, event coverage, podcast appearances, athlete features, speaking engagements and general bookings. We are passionate about sharing inspiring stories, celebrating sporting achievements and creating meaningful connections through sport.</p>
          </div>
          <div>
            <h3>Let’s connect, collaborate and create something meaningful</h3>
            <p>We welcome enquiries about sponsorships, advertising, partnerships, community events, corporate bookings and other opportunities to work together. Whether you have a story worth sharing, an event you’d like us to cover or an idea that aligns with our mission to uplift, serve and support others, our team would love to explore how we can help.</p>
          </div>
        </div>

        <div class="contact-methods">
          <a class="contact-method" href={`mailto:${site.partnerships.email}`}>
            <span class="contact-method__icon"><Icon name="mail" /></span>
            <span><small>Partnerships & sponsorship — {site.partnerships.name}</small><strong>{site.partnerships.email}</strong></span>
          </a>
          <a class="contact-method" href={site.instagram.url} target="_blank" rel="noopener">
            <span class="contact-method__icon"><Icon name="instagram" /></span>
            <span><small>Instagram</small><strong>{site.instagram.handle}</strong><span class="sr-only"> (opens in a new tab)</span></span>
          </a>
          <a class="contact-method" href={site.whatsappGroup} target="_blank" rel="noopener">
            <span class="contact-method__icon"><Icon name="whatsapp" /></span>
            <span><small>WhatsApp</small><strong>Join our WhatsApp group</strong><span class="sr-only"> (opens in a new tab)</span></span>
          </a>
          <a class="contact-method" href={site.youtube.url} target="_blank" rel="noopener">
            <span class="contact-method__icon"><Icon name="youtube" /></span>
            <span><small>YouTube</small><strong>{site.youtube.handle}</strong><span class="sr-only"> (opens in a new tab)</span></span>
          </a>
        </div>
      </div>

      <div class="form-card" data-reveal style="--d:.08s">
        <h2 class="display-m">Send a message</h2>
        <p class="form-note" style="margin-top:8px">Get in touch and be part of the growing Beach Volleyball TV community.</p>
        <form
          class="form-grid"
          style="margin-top:24px"
          action={enabled ? site.formEndpoint || `mailto:${site.email}` : undefined}
          method="post"
          enctype={enabled && !site.formEndpoint ? 'text/plain' : undefined}
          novalidate
          data-contact-form
          data-disabled={enabled ? undefined : ''}
          data-endpoint={site.formEndpoint}
          data-email={site.email}
          data-recipients={JSON.stringify(Object.fromEntries(enquiryTypes.map((t) => [t.value, recipientFor(t.value)])))}
        >
          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="cf-name">Name <span class="req" aria-hidden="true">*</span></label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-error" />
              <p class="field__error" id="cf-name-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-error" />
              <p class="field__error" id="cf-email-error" aria-live="polite"></p>
            </div>
          </div>
          <div class="field">
            <label for="cf-type">What’s it about?</label>
            <select id="cf-type" name="type">
              {enquiryTypes.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="cf-subject">Subject <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-subject" name="subject" type="text" required maxlength="140" aria-describedby="cf-subject-error" />
            <p class="field__error" id="cf-subject-error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="cf-message">Message <span class="req" aria-hidden="true">*</span></label>
            <textarea id="cf-message" name="message" required minlength="10" aria-describedby="cf-message-error"></textarea>
            <p class="field__error" id="cf-message-error" aria-live="polite"></p>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="cf-website">Leave this field empty</label>
            <input id="cf-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-status" role="status" tabindex="-1" data-form-status></div>
          {enabled ? (
            <button class="btn btn--teal" type="submit" style="justify-self:start">Send message <Icon name="arrow" class="arrow" /></button>
          ) : (
            <button class="btn btn--teal" type="button" aria-disabled="true" style="justify-self:start">Send message <Icon name="arrow" class="arrow" /></button>
          )}
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
