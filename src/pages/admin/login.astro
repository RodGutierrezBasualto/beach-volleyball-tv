---
export const prerender = false;
import '../../styles/admin.css';
import { loginDisabled } from '../../admin.config';

if (Astro.locals.isAdmin) return Astro.redirect('/admin/');
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/admin/';
const loggedOut = Astro.url.searchParams.has('loggedout');
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Log in ‹ Beach Volleyball TV Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=Instrument+Sans:wght@400..700&display=swap" />
  </head>
  <body class="admin" style="display:block">
    <main class="login">
      <div class="login__card">
        <img src="/images/logo-teal.png" alt="Beach Volleyball TV" width="946" height="386" />
        <h1>Website admin</h1>
        {error === 'invalid' && <div class="notice notice-error" role="alert">That username or password isn’t right. Please try again.</div>}
        {error === 'locked' && <div class="notice notice-error" role="alert">Too many attempts. Please wait 10 minutes and try again.</div>}
        {loggedOut && <div class="notice notice-success" role="status">You’ve been logged out.</div>}
        {loginDisabled() && <div class="notice notice-error" role="alert">Login is switched off until an admin password is set. In Cloudflare, add <b>ADMIN_PASSWORD</b> as a secret under the Worker’s Settings → Variables and Secrets (locally, put it in <b>.env</b>).</div>}
        <form method="post" action="/api/admin/login">
          <input type="hidden" name="next" value={next} />
          <div class="field">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" required autofocus />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required class="control" />
          </div>
          <button class="button button-primary button-large button-block" type="submit">Log in</button>
        </form>
        <a class="login__back" href="/">← Back to the website</a>
      </div>
    </main>
  </body>
</html>
