---
export const prerender = false;
import PageEditor from '../../components/admin/PageEditor.astro';
import type { Section } from '../../components/admin/page-fields';
import { getPage } from '../../lib/content';
import { HOME_PHOTO_RATIO } from '../../data/home';

const eyebrow = { type: 'text', key: 'eyebrow', label: 'Small label above the headline', max: 140 } as const;

const sections: Section[] = [
  {
    key: 'hero', title: 'Top banner',
    intro: 'The big opening section with the bouncing ball. The “Beach Volleyball TV” title itself stays as it is.',
    fields: [
      { type: 'text', key: 'kicker', label: 'Small line above the title', max: 140 },
      { type: 'text', key: 'tagline', label: 'Line under the title', max: 140 },
      { type: 'text', key: 'primaryLabel', label: 'First button', hint: 'Scrolls down to the welcome section.', max: 40, width: 'half' },
      { type: 'text', key: 'youtubeLabel', label: 'YouTube button', hint: 'Opens the YouTube channel.', max: 40, width: 'half' },
      { type: 'text', key: 'barLeft', label: 'Bottom line, left', max: 60, width: 'third' },
      { type: 'text', key: 'hint', label: 'Bottom line, middle', hint: 'Invites people to play with the ball.', max: 60, width: 'third' },
      { type: 'text', key: 'barRight', label: 'Bottom line, right', max: 60, width: 'third' },
    ],
  },
  {
    key: 'welcome', title: 'Welcome',
    intro: 'The first section under the banner, with the two photos.',
    fields: [
      eyebrow,
      { type: 'headline' },
      { type: 'paragraphs', label: 'Introduction' },
      {
        type: 'list', key: 'platforms', label: 'The three platform cards',
        itemNames: ['YouTube card', 'Instagram card', 'TikTok card'],
        hint: 'The cards link to the YouTube, Instagram and TikTok accounts.',
        fields: [{ key: 'title', label: 'Title', max: 80 }, { key: 'text', label: 'Text', max: 200 }],
      },
      { type: 'sub', label: 'Photos' },
      { type: 'photo', key: 'photoA', altKey: 'photoAAlt', label: 'Large photo', ratio: HOME_PHOTO_RATIO, width: 'half' },
      { type: 'photo', key: 'photoB', altKey: 'photoBAlt', label: 'Small round-cornered photo', ratio: HOME_PHOTO_RATIO, width: 'half' },
      { type: 'note', text: 'Both photos are cropped square.' },
    ],
  },
  {
    key: 'spotlight', title: 'Featured event', toggle: true,
    intro: 'Shows the event you ticked “Feature this event” on (in Events). The event’s own name, photo and details come from the event itself.',
    fields: [{ type: 'text', key: 'eyebrow', label: 'Small label above the event name', max: 140 }],
  },
  {
    key: 'videos', title: 'Videos', toggle: true,
    intro: 'Shows the featured video and the next two from Videos.',
    fields: [eyebrow, { type: 'headline' }, { type: 'textarea', key: 'text', label: 'Text under the headline', max: 600 }],
  },
  {
    key: 'news', title: 'Stories', toggle: true,
    intro: 'Shows the four latest news stories.',
    fields: [eyebrow, { type: 'headline' }],
  },
  {
    key: 'events', title: 'Upcoming events', toggle: true,
    intro: 'Shows the next three upcoming events (not counting the featured one).',
    fields: [eyebrow, { type: 'headline' }, { type: 'textarea', key: 'text', label: 'Text under the headline', max: 600 }],
  },
  {
    key: 'purpose', title: 'Our purpose', toggle: true,
    intro: 'The “More than just sport” section, with the two cards beside it.',
    fields: [
      eyebrow,
      { type: 'headline' },
      { type: 'paragraphs', label: 'Text' },
      { type: 'text', key: 'linkLabel', label: 'Link to the About page', max: 60 },
      { type: 'sub', label: 'Card: Get involved' },
      { type: 'text', key: 'involvedTitle', label: 'Card title', max: 60, width: 'half' },
      { type: 'text', key: 'involvedLink', label: 'Link text', hint: 'Opens the Get involved page.', max: 60, width: 'half' },
      { type: 'textarea', key: 'involvedText', label: 'Card text', max: 600 },
      { type: 'sub', label: 'Card: Join our community' },
      { type: 'text', key: 'joinTitle', label: 'Card title', max: 60 },
      { type: 'textarea', key: 'joinText', label: 'Card text', max: 600 },
      { type: 'text', key: 'instagramLabel', label: 'Instagram button', max: 40, width: 'half' },
      { type: 'text', key: 'whatsappLabel', label: 'WhatsApp button', max: 40, width: 'half' },
    ],
  },
  {
    key: 'partner', title: 'Partner with us', toggle: true,
    intro: 'The highlighted band that invites partners and sponsors.',
    fields: [
      eyebrow,
      { type: 'headline' },
      { type: 'textarea', key: 'text', label: 'Text', max: 600 },
      { type: 'textarea', key: 'note', label: 'Extra note (optional)', hint: 'Good for news like an upcoming event. Remember to update it when it’s over. Leave it empty to hide it.', max: 600 },
      { type: 'text', key: 'buttonLabel', label: 'Button', hint: 'Opens the Partners page.', max: 40 },
    ],
  },
  {
    key: 'connect', title: 'Connect with us', toggle: true,
    intro: 'The last section, with the contact button.',
    fields: [
      { type: 'text', key: 'eyebrow', label: 'Small label', max: 140 },
      { type: 'textarea', key: 'text', label: 'Text', max: 600 },
      { type: 'text', key: 'buttonLabel', label: 'Button', hint: 'Opens the Contact page.', max: 40 },
    ],
  },
];
---

<PageEditor
  name="home"
  title="Home page"
  intro="Change the wording and photos on the home page. Events, stories and videos fill in by themselves, from their own sections."
  sections={sections}
  data={getPage('home')}
  viewHref="/"
/>
