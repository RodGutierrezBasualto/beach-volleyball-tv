---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImagePicker from '../../../components/admin/ImagePicker.astro';
import { getArticle, imageRegistry } from '../../../lib/content';
import { newsCategories, type Article } from '../../../data/news';
import { img, todaySydney, jsonForScript } from '../../../lib/utils';
import type { RichNode } from '../../../lib/rich';

const slug = Astro.params.slug ?? 'new';
const isNew = slug === 'new';
const found = isNew ? undefined : getArticle(slug, true);
if (!isNew && !found) return Astro.redirect('/admin/news/');
const a: Partial<Article> = found ?? { category: 'Features', date: todaySydney(), author: 'Beach Volleyball TV' };
const saved = Astro.url.searchParams.has('saved');

// Give photos in the story a preview URL so the editor can show them.
const reg = imageRegistry();
const withPreviews = (n: RichNode): RichNode =>
  n.type === 'photo'
    ? { ...n, attrs: { ...n.attrs, src: reg[String(n.attrs?.name)] ? img(String(n.attrs?.name)).largest : null } }
    : n.content ? { ...n, content: n.content.map(withPreviews) } : n;
const editorDoc = withPreviews(a.content ?? { type: 'doc', content: [{ type: 'paragraph' }] });
---

<AdminLayout title={isNew ? 'Write new story' : `Edit: ${a.title}`} active="news">
  <div class="adm-head">
    <h1>{isNew ? 'Write new story' : 'Edit story'}</h1>
    <span class="spacer"></span>
    <a class="button" href="/admin/news/">← All stories</a>
  </div>

  {saved && (
    <div class="notice notice-success" role="status">
      Story saved{a.draft ? ' as a draft' : ' and will be live in about a minute'}. <a href={a.draft ? `/admin/preview/news/${a.slug}/` : `/news/${a.slug}/`} target="_blank" rel="noopener">{a.draft ? 'Preview draft' : 'View story'} →</a>
    </div>
  )}
  <div class="notice notice-error" role="alert" data-errors hidden></div>

  <form class="editor" data-editor="news" data-original-slug={isNew ? '' : a.slug} novalidate>
    <div class="editor__main">
      <label class="sr-only" for="title">Headline</label>
      <input class="title-input" id="title" name="title" type="text" value={a.title} placeholder="Headline" maxlength="160" required />

      <section class="postbox" style="margin-top:18px">
        <h2>Summary</h2>
        <div class="postbox__body">
          <div class="field">
            <label class="sr-only" for="excerpt">Summary</label>
            <textarea id="excerpt" name="excerpt" rows="3" maxlength="400" data-counter placeholder="One or two sentences that make people want to read on. Shown on story cards and Google.">{a.excerpt}</textarea>
          </div>
        </div>
      </section>

      <section class="rich" data-rich aria-label="Story">
        <div class="rich__toolbar" role="toolbar" aria-label="Formatting" data-rich-toolbar>
          <select class="rich__style" data-rich-style aria-label="Text style">
            <option value="p">Normal text</option>
            <option value="h2">Heading</option>
            <option value="h3">Subheading</option>
          </select>
          <span class="rich__sep" aria-hidden="true"></span>
          <button type="button" data-cmd="bold" title="Bold (Ctrl+B)" aria-label="Bold"><b>B</b></button>
          <button type="button" data-cmd="italic" title="Italic (Ctrl+I)" aria-label="Italic"><i style="font-family:Georgia,serif">I</i></button>
          <button type="button" data-cmd="underline" title="Underline (Ctrl+U)" aria-label="Underline"><u>U</u></button>
          <span class="rich__sep" aria-hidden="true"></span>
          <button type="button" data-cmd="bulletList" title="Bullet list" aria-label="Bullet list">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="7" r="1.6" /><circle cx="5" cy="12" r="1.6" /><circle cx="5" cy="17" r="1.6" /><path d="M10 7h10M10 12h10M10 17h10" /></svg>
          </button>
          <button type="button" data-cmd="orderedList" title="Numbered list" aria-label="Numbered list">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 7h10M10 12h10M10 17h10" /><text x="2.5" y="9" font-size="6.5" stroke="none" fill="currentColor">1</text><text x="2.5" y="14" font-size="6.5" stroke="none" fill="currentColor">2</text><text x="2.5" y="19" font-size="6.5" stroke="none" fill="currentColor">3</text></svg>
          </button>
          <button type="button" data-cmd="blockquote" title="Quote" aria-label="Quote">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h4v4c0 2-1 3-3 4M14 9h4v4c0 2-1 3-3 4" /></svg>
          </button>
          <span class="rich__sep" aria-hidden="true"></span>
          <button type="button" data-cmd="link" title="Link (Ctrl+K)" class="rich__labelled">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg> Link
          </button>
          <button type="button" data-cmd="photo" title="Insert a photo" class="rich__labelled">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 18 5-5 4 4 3-3 4 4" /></svg> Photo
          </button>
          <button type="button" data-cmd="video" title="Insert a YouTube video" class="rich__labelled">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4" /><path d="m10 9.5 5 2.5-5 2.5z" fill="currentColor" /></svg> Video
          </button>
          <span class="rich__spacer"></span>
          <button type="button" data-cmd="undo" title="Undo (Ctrl+Z)" aria-label="Undo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5" /><path d="M4 12h11a5 5 0 0 1 0 10h-2" /></svg>
          </button>
          <button type="button" data-cmd="redo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 7 5 5-5 5" /><path d="M20 12H9a5 5 0 0 0 0 10h2" /></svg>
          </button>
        </div>
        <div class="rich__page" data-rich-editor></div>
        <p class="rich__help">Tip: you can paste straight from Word or Google Docs, and drag photos into the text. Select words and press <b>Link</b> to add a link.</p>
        <script type="application/json" data-rich-json set:html={jsonForScript(editorDoc)} />
      </section>
    </div>

    <div class="editor__side">
      <section class="postbox">
        <h2>Publish</h2>
        <div class="postbox__body">
          <label class="choice"><input type="radio" name="draft" value="false" checked={!a.draft} /> <span><b>Published</b><small>Visible on the website</small></span></label>
          <label class="choice"><input type="radio" name="draft" value="true" checked={!!a.draft} /> <span><b>Draft</b><small>Only you can see it</small></span></label>
          <label class="choice"><input type="checkbox" name="featured" checked={!!a.featured} /> <span><b>Feature this story</b><small>Shown large at the top of the News page</small></span></label>
          <div class="field"><label for="date">Publish date</label><input id="date" name="date" type="date" value={a.date} /></div>
          <div class="field"><label for="author">Author</label><input id="author" name="author" type="text" value={a.author} /></div>
          {!isNew && <a href={a.draft ? `/admin/preview/news/${a.slug}/` : `/news/${a.slug}/`} target="_blank" rel="noopener">{a.draft ? 'Preview draft' : 'View on website'} ↗</a>}
        </div>
        <div class="publish-actions">
          {isNew ? <span></span> : <button class="link-danger" type="button" data-editor-delete data-title={a.title}>Delete</button>}
          <button class="button button-primary button-large" type="submit">{isNew ? 'Publish' : 'Save changes'}</button>
        </div>
      </section>

      <section class="postbox">
        <h2>Category</h2>
        <div class="postbox__body">
          <select class="control" name="category" aria-label="Category">
            {newsCategories.map((c) => <option value={c} selected={a.category === c}>{c}</option>)}
          </select>
        </div>
      </section>

      <section class="postbox">
        <h2>Main photo</h2>
        <div class="postbox__body">
          <ImagePicker name="image" value={isNew ? '' : a.image} alt={a.imageAlt} altName="imageAlt" label="Main photo" />
        </div>
      </section>
    </div>
  </form>
</AdminLayout>
