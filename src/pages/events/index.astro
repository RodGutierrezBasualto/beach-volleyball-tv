---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import { eventTypes } from '../../data/events';
import { upcomingEvents, eventDateLabel, eventTimeLabel, contactUrl } from '../../lib/utils';

const upcoming = upcomingEvents();
const featured = upcoming.find((e) => e.featured) ?? upcoming[0];
const rest = upcoming.filter((e) => e !== featured);
const counts = Object.fromEntries(eventTypes.map((t) => [t.value, rest.filter((e) => e.type === t.value).length]));
---

<BaseLayout
  title="Events — Tournaments, Clinics & Community Sessions"
  description="Beach volleyball tournaments, clinics and social sessions in Bondi, Coogee and Sydney’s Eastern Suburbs. Find dates, locations and register online."
>
  <PageHeader
    eyebrow="Events"
    title="Tournaments, clinics <em>& community</em> on the sand"
    lede="From free sunrise socials to our flagship Bondi Summer Open — find your next game across Bondi and Sydney’s Eastern Suburbs."
    image="bv-ball-sand"
    imageAlt="A volleyball resting in the sand beside the court line"
  >
    <Fragment slot="actions">
      <a class="btn" href="#all-events">Browse events <Icon name="arrow" class="arrow" /></a>
      <a class="btn btn--ghost" href={contactUrl('partnership', 'Hosting or partnering on an event')}>Host an event with us</a>
    </Fragment>
  </PageHeader>

  {featured && (
    <section class="section section--tight" aria-labelledby="featured-event">
      <div class="container">
        <article class="event-feature" data-reveal>
          <Photo name={featured.image} alt={featured.imageAlt} sizes="(min-width: 900px) 55vw, 100vw" />
          <div class="event-feature__body">
            <span class="eyebrow eyebrow--light">Next big event · {featured.type}</span>
            <h2 id="featured-event"><a class="stretched" href={`/events/${featured.slug}/`}>{featured.title}</a></h2>
            <p>{featured.excerpt}</p>
            <div class="event-feature__facts">
              <span><Icon name="calendar" />{featured.recurring ? `${featured.recurring} · ` : ''}{eventDateLabel(featured)}</span>
              <span><Icon name="clock" />{eventTimeLabel(featured)}</span>
              <span><Icon name="pin" />{featured.venue}, {featured.suburb}</span>
            </div>
            <div class="event-feature__actions">
              <a class="btn btn--light" href={contactUrl('events', `Registration: ${featured.title}`)}>{featured.ctaLabel} <Icon name="arrow" class="arrow" /></a>
              <a class="btn btn--ghost-light" href={`/events/${featured.slug}/`}>Event details</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="section" id="all-events" aria-labelledby="all-events-title" style="padding-top: clamp(32px, 4vw, 56px)">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">Calendar</span>
          <h2 id="all-events-title" class="display-l">All upcoming events</h2>
        </div>
        <div class="chips" id="event-filters" data-filter-group data-filter-target="#event-grid" role="group" aria-label="Filter events by type">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="count">{rest.length}</span></button>
          {eventTypes.map((t) => (
            <button class="chip" type="button" data-filter={t.value} aria-pressed="false">{t.label} <span class="count">{counts[t.value]}</span></button>
          ))}
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status="event-filters"></p>
      <div class="grid-cards" id="event-grid">
        {rest.map((e, i) => <EventCard event={e} delay={(i % 3) * 0.06} />)}
      </div>
      <div class="empty" data-filter-empty="event-filters" hidden>
        <strong>Nothing in this category right now</strong>
        New dates are added regularly — <a class="link-arrow" href={contactUrl('events', 'Let me know about new events')}>ask to be notified</a>
      </div>
      {upcoming.length === 0 && (
        <div class="empty"><strong>New dates coming soon</strong>Follow us on Instagram to hear about the next event first.</div>
      )}
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="host-title">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow" style="color: var(--ink)">Partners & clubs</span>
          <h2 id="host-title" style="margin-top:14px">Running an event? <em>Let’s film it.</em></h2>
          <p>We partner with clubs, associations and brands to run, promote and film beach volleyball events across Sydney.</p>
        </div>
        <div class="cta-band__actions">
          <a class="btn" href={contactUrl('partnership', 'Event partnership')}>Partner with us <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
