---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import EventCta from '../../components/EventCta.astro';
import ContactButton from '../../components/ContactButton.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { upcomingEvents, eventDateLabel, eventTimeLabel } from '../../lib/utils';

const upcoming = upcomingEvents();
const featured = upcoming.find((e) => e.featured);
const weekly = upcoming.filter((e) => e !== featured && e.recurring);
const others = upcoming.filter((e) => e !== featured && !e.recurring);
---

<BaseLayout
  title="Events — Community Days, Tournaments & Weekly Games"
  description="Beach volleyball community days, tournaments and free weekly social games at Bondi Beach. Find upcoming events and get involved."
>
  <PageHeader
    eyebrow="Events"
    title="Community days, tournaments <em>& upcoming events</em>"
    lede="Be part of the action and discover exciting beach volleyball events, from local community days and social games to state, national and international tournaments."
    image="bv-sunset-silhouettes"
    imageAlt="Players leaping at the net against a golden sunset"
  >
    <Fragment slot="actions">
      <a class="btn" href="#weekly">Weekly games <Icon name="arrow" class="arrow" /></a>
      <a class="btn btn--ghost" href={site.instagramGroup} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram group</a>
    </Fragment>
  </PageHeader>

  <section class="section section--tight">
    <div class="container">
      <p class="lede" data-reveal style="max-width:75ch">
        Stay informed about upcoming competitions, special events and opportunities to get involved. Whether you’re an athlete, beginner, volunteer, supporter or family, there’s something for everyone as we bring people together, celebrate our sport and build stronger communities.
      </p>
    </div>
  </section>

  {featured && (
    <section class="section section--tight" aria-labelledby="featured-event" style="padding-top:0">
      <div class="container">
        <article class="event-feature" data-reveal>
          <Photo name={featured.image} alt={featured.imageAlt} sizes="(min-width: 900px) 55vw, 100vw" />
          <div class="event-feature__body">
            <span class="eyebrow eyebrow--light">Coming {eventDateLabel(featured).replace(/^\w+, /, '')}</span>
            <h2 id="featured-event"><a class="stretched" href={`/events/${featured.slug}/`}>{featured.title}</a></h2>
            <p>{featured.excerpt}</p>
            <div class="event-feature__facts">
              <span><Icon name="calendar" />{eventDateLabel(featured)}</span>
              <span><Icon name="clock" />{eventTimeLabel(featured)}</span>
              <span><Icon name="pin" />{featured.venue}, {featured.suburb}</span>
            </div>
            <div class="event-feature__actions">
              <EventCta event={featured} class="btn btn--light" />
              <a class="btn btn--ghost-light" href={`/events/${featured.slug}/`}>Event details</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="section" id="weekly" aria-labelledby="weekly-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">Every week</span>
          <h2 id="weekly-title" class="display-l">Weekly events</h2>
          <p>Free social beach volleyball at Bondi Beach. Check our Instagram or WhatsApp group for updates.</p>
        </div>
      </div>
      {weekly.length ? (
        <div class="grid-cards">{weekly.map((e, i) => <EventCard event={e} delay={i * 0.06} />)}</div>
      ) : (
        <div class="empty"><strong>Weekly games will be back soon</strong>Follow us on Instagram for updates.</div>
      )}
    </div>
  </section>

  {others.length > 0 && (
    <section class="section section--soft" aria-labelledby="more-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <div class="section-head__text">
            <span class="eyebrow">Calendar</span>
            <h2 id="more-title" class="display-l">More upcoming events</h2>
          </div>
        </div>
        <div class="grid-cards">{others.map((e, i) => <EventCard event={e} delay={(i % 3) * 0.06} />)}</div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="news-title">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow" style="color: var(--ink)">Never miss an event</span>
          <h2 id="news-title" style="margin-top:14px">Join our mailing list <em>& newsletter.</em></h2>
          <p>Follow Beach Volleyball TV on Instagram and join our Instagram group for the full schedule and event updates.</p>
        </div>
        <div class="cta-band__actions">
          <ContactButton label="Join the mailing list" href="/contact/?type=general&subject=Join%20the%20mailing%20list" />
          <a class="btn btn--light" href={site.instagramGroup} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram group</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
