---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactButton from '../components/ContactButton.astro';
import InstagramStats from '../components/InstagramStats.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getPage } from '../lib/content';
import { headlineHtml } from '../lib/utils';

const { header, intro, now, reach, talk } = getPage('partners');
---

<BaseLayout
  title="Partners & Sponsors — Advertising, Sponsorship & Commercial Partnerships"
  description="Partner with Beach Volleyball TV and connect your brand with a growing community of athletes, sporting enthusiasts, families and fans across Australia and beyond."
>
  <PageHeader eyebrow={header.eyebrow} title={headlineHtml(header)} lede={header.lede} image={header.photo} imageAlt={header.photoAlt}>
    <Fragment slot="actions">
      <ContactButton label={header.buttonLabel} href="/contact/?type=partnership" />
      <a class="btn btn--ghost" href={`mailto:${site.partnerships.email}`}><Icon name="mail" /> Email {site.partnerships.name}</a>
    </Fragment>
  </PageHeader>

  <section class="section">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow">{intro.eyebrow}</span>
        <h2 class="display-l" style="margin-top:14px" set:html={headlineHtml(intro)} />
        {intro.paragraphs.map((p, i) => <p class="lede" style={`margin-top:${i ? 14 : 20}px`}>{p}</p>)}
      </div>
      <div class="info-cards">
        <article class="info-card" data-reveal style="--d:.06s">
          <span class="info-card__icon"><Icon name="handshake" /></span>
          <h3>{intro.waysTitle}</h3>
          <ul class="tick-list" role="list">{intro.ways.map((w) => <li>{w.title}</li>)}</ul>
        </article>
        {now.show && (
          <article class="info-card info-card--accent" data-reveal style="--d:.12s">
            <span class="info-card__icon"><Icon name="megaphone" /></span>
            <h3>{now.title}</h3>
            {now.text && <p><b>{now.text}</b></p>}
            {now.linkText && <a class="link-arrow" href="/events/">{now.linkText} <Icon name="arrow" /></a>}
          </article>
        )}
      </div>
    </div>
  </section>

  {reach.show && (
  <section class="section section--soft" aria-labelledby="reach-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-head__text">
          <span class="eyebrow">{reach.eyebrow}</span>
          <h2 id="reach-title" class="display-l" set:html={headlineHtml(reach)} />
        </div>
      </div>
      <InstagramStats />
    </div>
  </section>
  )}

  {talk.show && (
  <section class="section">
    <div class="container connect" data-reveal>
      <div>
        <span class="eyebrow">{talk.eyebrow}</span>
        <h2 class="display-m" style="margin-top:12px">Contact {site.partnerships.name} at <a class="text-link" href={`mailto:${site.partnerships.email}`}>{site.partnerships.email}</a></h2>
      </div>
      <ContactButton label={talk.buttonLabel} href="/contact/?type=partnership" />
    </div>
  </section>
  )}
</BaseLayout>
